# EXAMPLE ONLY. Never put real secrets in tracked files.
# Copy to a local .env that is git-ignored; do not log the contents.
OPENAI_API_KEY=
FAL_KEY=

# Model used to make routing decisions, NOT the worker model. OPENAI_API_KEY can also be a Pi provider credential.
# `harnessrouter init` writes selector "local" and needs no decision API key.
# A config file or process that omits selector still resolves to decisions (OpenAI).
# Uncomment one ROUTER_SELECTOR line to override the file. Hosted decisions needs the matching key.
# ROUTER_SELECTOR=local
# ROUTER_SELECTOR=decisions
# ROUTER_DECISION_PROVIDER=openai
# DECISIONS_MODEL=gpt-6-luna
# ROUTER_DECISION_RESERVE_USD=0.01
# ROUTER_DECISION_TIMEOUT_MS=10000

# Hosted TypeSafe/Jev credentials are separate from OPENAI_API_KEY and do not switch providers.
# Set only one of TYPESAFE_API_KEY or its JEV_API_KEY compatibility alias.
TYPESAFE_API_KEY=
# JEV_API_KEY=

# Optional local Ollaya key and loopback-only origin; no remote origins are accepted.
OLLAYA_API_KEY=
# ROUTER_OLLAYA_BASE_URL=http://127.0.0.1:11435

# Safe startup flags
ROUTER_DRY_RUN=true
# Video is unsupported. Each creative run submits at most one paid job;
# recovery reconciles the saved request ID rather than repeating generation.
ROUTER_ALLOW_PAID_RUNS=false

# Proposed budgets; user must explicitly approve enabling paid runs.
MAX_COST_USD_PER_TASK=0.25
MAX_COST_USD_PER_SESSION=2.00
PI_TASK_TIMEOUT_MS=120000
FAL_TASK_TIMEOUT_MS=180000

# auto chooses between image profiles with Decisions when both are eligible.
# fast or quality pins one profile and skips that Decisions call.
# An explicit task creativeOptions.quality of fast or high overrides this pin.
ROUTER_IMAGE_ROUTE=auto

# Only allow safe, explicit URLs for browser demo.
BROWSER_ALLOWED_DOMAINS=example.com
ARTIFACTS_DIR=./artifacts
# Traces are stored beside each run's artifacts under ARTIFACTS_DIR/<runId>/.

# Pi provider auth is specific to the configured model/provider; do not guess.
# Set up via official Pi provider settings, not a made-up PI_API_KEY variable.

# Project dotenv/config files require explicit local trust. Prefer --config for router JSON.
# Export HARNESSROUTER_TRUST_PROJECT_CONFIG=true in your shell after reviewing the project.
ROUTER_ALLOW_EXECUTION=false
