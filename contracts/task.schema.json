{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harnessrouter.local/contracts/task.schema.json",
  "title": "HarnessTask v1.1 (v1.0 compatible)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "prompt",
    "requirements",
    "acceptanceCriteria"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "acceptanceCriteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requiredCapabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "context": {
      "type": "object"
    },
    "allowedDomains": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "desiredOutput": {
      "enum": [
        "text",
        "screenshot",
        "image",
        "video",
        "mixed",
        "patch"
      ]
    },
    "maxCostUsd": {
      "type": "number",
      "minimum": 0
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 1000
    },
    "allowPaidExecution": {
      "type": "boolean",
      "default": false
    },
    "parentRunId": {
      "type": "string"
    },
    "preferredRouteId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 150
    },
    "allowUnknownCost": {
      "type": "boolean",
      "default": false
    },
    "async": {
      "type": "boolean",
      "description": "When true, route_task stores the run and returns immediately. The run is not cancelled if this request is aborted. The default waits for the worker."
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "mode"
      ],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "mode": {
          "enum": [
            "read-only",
            "patch"
          ]
        },
        "includeUntracked": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
