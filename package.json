{
  "name": "harnessrouter",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "description": "Local MCP router that hands a bounded task to Codex, Claude Code, OpenCode, or Pi and returns text or a patch.",
  "main": "dist/api.js",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "test": "tsx --test tests/unit/*.test.ts tests/integration/*.test.ts",
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "smoke:dry": "tsx scripts/smoke.ts dry",
    "smoke:live": "tsx scripts/smoke.ts live",
    "precheck": "tsx scripts/precheck.ts",
    "mcp:smoke": "tsx scripts/mcp-smoke.ts",
    "mcp:call": "tsx scripts/mcp-call.ts",
    "baseline": "tsx scripts/baseline.ts",
    "eval:live": "tsx scripts/eval.ts",
    "eval:harnesses": "tsx scripts/evaluate-harnesses.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "domain:allow": "tsx scripts/allow-domain.ts",
    "task:compose": "tsx scripts/compose-image-task.ts",
    "eval:pilot": "tsx scripts/evaluate-pilot.ts",
    "package:check": "node scripts/package-check.mjs",
    "prepack": "npm run build",
    "check": "npm run typecheck && npm test && npm run build && npm run package:check",
    "package:smoke": "node scripts/package-smoke.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "router",
    "agents",
    "harness",
    "codex",
    "claude-code",
    "opencode",
    "pi"
  ],
  "author": "\u00d6zg\u00fcr Ery\u0131lmaz",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "ajv": "8.20.0",
    "dotenv": "18.0.7",
    "openai": "7.32.0",
    "typebox": "1.3.27",
    "yaml": "2.9.1",
    "zod": "4.6.6"
  },
  "overrides": {
    "deepeval": {
      "uuid": "11.1.1",
      "@opentelemetry/exporter-trace-otlp-grpc": "0.223.0",
      "@opentelemetry/exporter-trace-otlp-proto": "0.223.0"
    }
  },
  "devDependencies": {
    "@sentry/node": "11.7.0",
    "@types/node": "26.6.5",
    "deepeval": "0.9.22",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "types": "dist/api.d.ts",
  "bin": {
    "harnessrouter": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js"
    },
    "./contracts/*": "./contracts/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "contracts/",
    "config/harness-registry.yaml",
    "config/.env.example",
    "docs/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "SECURITY.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ozgureyilmaz/harnessrouter.git"
  },
  "homepage": "https://github.com/ozgureyilmaz/harnessrouter",
  "bugs": {
    "url": "https://github.com/ozgureyilmaz/harnessrouter/issues"
  },
  "optionalDependencies": {
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@fal-ai/client": "1.10.1",
    "playwright": "1.64.0",
    "sharp": "0.35.5"
  }
}
